// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  avatarUrl     String?
  role          String         @default("MEMBER")
  organizationId String
  organization  Organization   @relation(fields: [organizationId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  records       Record[]       @relation("RecordCreator")
  approvals     WorkflowStepInstance[] @relation("WorkflowStepApprover")
  auditLogs     AuditLog[]
  notifications Notification[]
  comments      Comment[]
  assignedTasks Task[]         @relation("TaskAssignee")
  createdTasks  Task[]         @relation("TaskCreator")

  @@map("users")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  inviteCode String   @unique
  subscriptionStatus String @default("inactive")
  planPriceCents Int @default(400)
  planCurrency String @default("USD")
  billingCardLast4 String?
  billingCardBrand String?
  billingUpdatedAt DateTime?
  createdAt DateTime  @default(now())
  users     User[]
  entityTypes EntityType[]
  records  Record[]
  tasks    Task[]

  @@map("organizations")
}

model EntityType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  schema         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workflowDefinition WorkflowDefinition?
  records        Record[]

  @@unique([organizationId, name])
  @@map("entity_types")
}

model Record {
  id             String       @id @default(cuid())
  entityTypeId   String
  entityType     EntityType   @relation(fields: [entityTypeId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  data           Json
  status         String       @default("PENDING_APPROVAL")
  createdById    String
  createdBy      User         @relation("RecordCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workflowInstance WorkflowInstance?
  comments       Comment[]
  tasks          Task[]

  @@map("records")
}

model WorkflowDefinition {
  id           String     @id @default(cuid())
  entityTypeId String     @unique
  entityType   EntityType @relation(fields: [entityTypeId], references: [id])
  steps        Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("workflow_definitions")
}

model WorkflowInstance {
  id          String     @id @default(cuid())
  recordId    String     @unique
  record      Record     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  currentStep Int        @default(1)
  status      String     @default("PENDING_APPROVAL")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  steps       WorkflowStepInstance[]

  @@map("workflow_instances")
}

model WorkflowStepInstance {
  id                 String     @id @default(cuid())
  workflowInstanceId String
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stepNumber         Int
  status             String     @default("PENDING")
  assignedApproverIds Json?
  dueAt              DateTime?
  lastSlaNotifiedAt  DateTime?
  escalatedAt        DateTime?
  approvedById       String?
  approvedBy         User?      @relation("WorkflowStepApprover", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  createdAt          DateTime   @default(now())

  @@unique([workflowInstanceId, stepNumber])
  @@map("workflow_step_instances")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum CommentType {
  COMMENT
  QUESTION
  BLOCKER
}

model Comment {
  id        String   @id @default(cuid())
  recordId  String
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  type      CommentType @default(COMMENT)
  parentId  String?
  parent    Comment? @relation("CommentThread", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentThread")
  mentions  Json?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([recordId, createdAt])
  @@map("comments")
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  recordId  String?
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskType {
  IMPLEMENTATION
  REVIEW
  DOCUMENTATION
  FOLLOW_UP
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus   @default(BACKLOG)
  type            TaskType     @default(OTHER)
  priority        TaskPriority @default(MEDIUM)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  recordId        String?
  record          Record?      @relation(fields: [recordId], references: [id], onDelete: SetNull)
  assigneeId      String?
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById     String
  createdBy       User         @relation("TaskCreator", fields: [createdById], references: [id])
  parentTaskId    String?
  parentTask      Task?        @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks        Task[]       @relation("Subtasks")
  dueAt           DateTime?
  estimateHours   Float?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  blockedBy       TaskDependency[] @relation("BlockedTask")
  blocking        TaskDependency[] @relation("BlockingTask")

  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([recordId])
  @@map("tasks")
}

model TaskDependency {
  id             String @id @default(cuid())
  blockedTaskId  String
  blockedTask    Task   @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTaskId String
  blockingTask   Task   @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([blockedTaskId, blockingTaskId])
  @@map("task_dependencies")
}
